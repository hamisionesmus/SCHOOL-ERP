# Postgres
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=school_erp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://erp:erp_dev_password@localhost:5432/school_erp?schema=public
# Used only for `prisma migrate dev` against the tenant schema template (generates migration files).
TENANT_TEMPLATE_DATABASE_URL=postgresql://erp:erp_dev_password@localhost:5432/school_erp?schema=tenant_template

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seed
SUPER_ADMIN_EMAIL=superadmin@school-erp.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
