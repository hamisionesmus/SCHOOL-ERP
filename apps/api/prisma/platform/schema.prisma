generator client {
  provider = "prisma-client-js"
  output   = "../../generated/platform-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum PlatformRole {
  SUPER_ADMIN
}

model SubscriptionPlan {
  id              String   @id @default(uuid())
  name            String   @unique
  maxStudents     Int
  maxStaff        Int
  storageLimitMb  Int
  priceMonthlyKes Decimal  @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenants Tenant[]
}

model Tenant {
  id                     String            @id @default(uuid())
  name                   String
  slug                   String            @unique
  schemaName             String            @unique
  logoUrl                String?
  primaryColor           String?           @default("#2563eb")
  address                String?
  website                String?
  smsSenderId            String?
  status                 TenantStatus      @default(TRIAL)
  storageLimitMbOverride Int?
  subscriptionPlanId     String?
  subscriptionPlan       SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?
}

model PlatformUser {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  fullName         String
  role             PlatformRole @default(SUPER_ADMIN)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  refreshTokens PlatformRefreshToken[]
}

model PlatformRefreshToken {
  id             String       @id @default(uuid())
  tokenHash      String       @unique
  platformUserId String
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id])
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
}

model PlatformAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
}
