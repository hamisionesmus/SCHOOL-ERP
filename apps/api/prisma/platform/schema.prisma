generator client {
  provider = "prisma-client-js"
  output   = "../../generated/platform-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  // Real (non-demo) school created but not yet paid for — login is blocked until the activation
  // fee is paid via M-Pesa STK push. See TenantsService.confirmCreate() and AuthService.login().
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
}

enum MpesaStkStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PlatformRole {
  SUPER_ADMIN
  // Sits above SUB_ADMIN: can create schools (self-confirms their own OTP, unlike SUB_ADMIN — see
  // TenantsService.requestCreate()'s isSubAdmin branch) and record finance ledger entries, but is
  // blocked from Security, Backups, Audit Logs, Platform Settings, Message Templates, Admins
  // management, and Tickets — same RequirePlatformRole gates as SUB_ADMIN, plus finance access.
  ASSISTANT_SUPER_ADMIN
  // Delegated admin: can create schools (still gated by an OTP sent to a real SUPER_ADMIN, never to
  // themselves — see TenantsService.requestCreate()) and view revenue/earnings, but is blocked from
  // Security, Backups, Audit Logs, Platform Settings, and Message Templates — see
  // RequirePlatformRole('SUPER_ADMIN') usages.
  SUB_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum FinanceEntryType {
  IN
  OUT
}

enum FeedbackContext {
  DEMO_EXPIRY
  TICKET_RESOLUTION
}

enum BillingCycle {
  MONTHLY
  HALF_YEARLY
  YEARLY
}

enum PlatformInvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PlatformPaymentMethod {
  BANK
  MPESA
  CASH
  PAYBILL
}

enum PaymentProofMethod {
  BANK
  PAYBILL
}

enum PaymentProofStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model SubscriptionPlan {
  id              String   @id @default(uuid())
  name            String   @unique
  maxStudents     Int
  maxStaff        Int
  storageLimitMb  Int
  priceMonthlyKes Decimal  @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenants Tenant[]
}

model Tenant {
  id                     String            @id @default(uuid())
  name                   String
  slug                   String            @unique
  schemaName             String            @unique
  logoUrl                String?
  primaryColor           String?           @default("#2563eb")
  // App reskin: sidebar background + main content-pane background. Text color is never stored —
  // the frontend derives readable foreground/hover/active/border shades from these at render time
  // (apps/web/src/lib/theme-color.ts), so a school can't accidentally pick a color that makes its
  // own sidebar unreadable. Null means "use the app default" (white sidebar, slate-50 content).
  sidebarColor           String?
  contentBgColor         String?
  address                String?
  // County is constrained client/server-side to Kenya's 47 official counties (see
  // apps/api/src/common/kenya-counties.ts) but stored as a plain string, not a Prisma enum, so the
  // list can be extended without a migration. Town is free text (county alone is precise enough for
  // grouping/reporting; town is just a helpful label for follow-ups).
  county                 String?
  town                   String?
  website                String?
  smsSenderId            String?
  // Captured from the creation request so the platform can reach the school directly (activation
  // link, "you're now active" notice, future billing reminders) without depending on the tenant's
  // own schema — which doesn't exist yet, or isn't queryable, before activation.
  contactEmail           String?
  contactPhone           String?
  // Editable by the School Administrator via the tenant-scoped Settings module — pure branding,
  // no financial/PII sensitivity, so no reason to route it through the Super Admin.
  mission                String?
  vision                 String?
  motto                  String?
  // Report-card pass/fail coloring threshold (numeric scores only — CBC rubric levels use a fixed
  // EE/ME=green, AE=amber, BE=red mapping instead). Same trust boundary as mission/vision/motto.
  passMarkPercent        Int               @default(50)
  // Editable by the Super Admin only (platform/tenants endpoints) — payment credentials are a
  // platform-level concern, same trust boundary as subscriptionPlan/status/storage limits.
  mpesaPaybill           String?
  bankName               String?
  bankAccountName        String?
  bankAccountNumber      String?
  status                 TenantStatus      @default(TRIAL)
  storageLimitMbOverride Int?
  subscriptionPlanId     String?
  subscriptionPlan       SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  // Billing: manually invoiced by the Super Admin (no scheduled job in this environment generates
  // renewal invoices automatically — see docs/SRS.md §4.1). currentPeriodEnd drives the renewal
  // countdown shown on the Super Admin dashboard; recording a payment against an invoice extends it
  // and reactivates a SUSPENDED tenant automatically (see TenantsService.recordPayment()).
  billingCycle           BillingCycle      @default(MONTHLY)
  currentPeriodEnd       DateTime?
  // First-login onboarding: false until the School Administrator saves the Settings page once
  // (branding/payment review, password change prompt lives client-side). Drives a forced redirect
  // to /school/settings so a freshly-provisioned school doesn't skip setup.
  settingsConfigured     Boolean           @default(false)
  // Demo/trial accounts created by the Super Admin with a time-boxed expiry (hours or days, chosen
  // at creation). Enforced live at login (same check as SUSPENDED) — no background job expires it,
  // since this environment has no scheduler; see docs/SRS.md §4.1.
  isDemo                 Boolean           @default(false)
  demoExpiresAt          DateTime?
  // Disposable variant of a demo account — same expiry/reminder/feedback machinery as isDemo
  // (always true alongside isDemo), the only difference is a delete button in the UI and a distinct
  // "TEST" badge. Deletion is hard-guarded server-side to isTest tenants only, regardless of caller
  // — see TenantsService.deleteTestTenant().
  isTest                 Boolean           @default(false)
  // Dedupe flags for RemindersService's daily job — set once a reminder fires so it isn't re-sent
  // every day of the window; renewalReminderSentAt is cleared back to null whenever currentPeriodEnd
  // moves forward (a new payment clears the way for the next cycle's reminder).
  demoReminderSentAt     DateTime?
  renewalReminderSentAt  DateTime?
  // Which Super Admin/Sub-Admin actually created this school — nullable since it can't be backfilled
  // for tenants created before this field existed unless a matching TenantCreationRequest exists
  // (see the migration's data-backfill UPDATE).
  createdById            String?
  createdBy              PlatformUser?     @relation(fields: [createdById], references: [id])
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?

  invoices PlatformInvoice[]
  auditLogAccessRequests AuditLogAccessRequest[]
  userDirectoryEntries UserDirectoryEntry[]
  mpesaStkRequests PlatformMpesaStkRequest[]
  paymentProofs PlatformPaymentProof[]
  feedback TenantFeedback[]
  ticketEscalations PlatformTicketEscalation[]
}

// Global email → school lookup, kept in sync whenever a tenant-side User is created (see
// UserDirectoryService). Lets login resolve which school an email belongs to without the user
// having to type a school slug — see AuthService.login(). Enforces email uniqueness across the
// whole platform (not just within one school) as a side effect: two schools can never register the
// same person's email independently.
model UserDirectoryEntry {
  id        String   @id @default(uuid())
  email     String   @unique
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// Two-step tenant creation: the Super Admin submits the school details, a 6-digit code is sent to
// their own registered email/phone (platform email/SMS stubs — logs instead of sending, same
// pattern as every other provider in this app), and only submitting that code actually creates the
// tenant. This prevents a compromised or unattended Super Admin session from silently provisioning
// schools.
model TenantCreationRequest {
  id             String    @id @default(uuid())
  name           String
  slug           String
  code           String
  // Second, independent verification: proves the phone number given for the new admin is real and
  // that person consents, alongside (not instead of) the Super Admin's own code above. Sent via SMS
  // to adminPhone at request time — see TenantsService.requestCreate()/confirmCreate().
  adminOtpCode      String
  adminOtpVerifiedAt DateTime?
  requestedById  String
  requestedBy    PlatformUser @relation(fields: [requestedById], references: [id])
  adminFullName     String
  adminEmail        String
  adminPhone        String
  adminPasswordHash String
  planId            String?
  // Demo/trial requests: isDemo + demoDurationHours (from the Super Admin's day/hour picker) get
  // applied to the resulting Tenant on confirmation — see TenantsService.confirmCreate().
  isDemo            Boolean   @default(false)
  // Disposable variant of a demo request — see Tenant.isTest's doc comment. Always paired with
  // isDemo: true when set.
  isTest            Boolean   @default(false)
  demoDurationHours Int?
  // One-time activation fee the Super Admin sets for this specific school (not tied to the
  // recurring subscriptionPlan price) — required for non-demo requests. Becomes the amount on the
  // first PlatformInvoice, paid via M-Pesa STK push before the school can log in.
  activationFeeKes  Decimal?
  // Which billing period the activation fee covers — chosen alongside the fee for non-demo
  // requests, used to compute the first PlatformInvoice's periodEnd and the Tenant's own
  // billingCycle at creation (previously hardcoded to 30 days / MONTHLY regardless of this field).
  activationBillingCycle BillingCycle?
  // Expected headcount for non-demo requests — drives the server-computed activationFeeKes via
  // PricingTiersService.computeFee() (the client never supplies the fee directly). Nullable since
  // demo/test requests never set these.
  studentCount           Int?
  teacherCount           Int?
  nonTeachingStaffCount  Int?
  // Storage cap (MB) from the PricingTier that matched the headcount above at request time —
  // applied to Tenant.storageLimitMbOverride on confirmation. Null means the matched tier had no
  // cap configured.
  storageLimitMb         Int?
  // Carried through to the resulting Tenant on confirmation — see TenantsService.confirmCreate().
  county            String?
  town              String?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
}

model PlatformUser {
  id               String    @id @default(uuid())
  email            String    @unique
  // Used to SMS the school-creation confirmation code (alongside email) and other admin alerts.
  // Seeded from SUPER_ADMIN_PHONE — see prisma/seed.ts.
  phone            String?
  passwordHash     String
  fullName         String
  avatarUrl        String?
  role             PlatformRole @default(SUPER_ADMIN)
  gender           Gender?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  refreshTokens    PlatformRefreshToken[]
  paymentsRecorded PlatformPayment[]
  auditLogAccessRequests AuditLogAccessRequest[]
  paymentProofsReviewed PlatformPaymentProof[]
  settingsChangeRequests PlatformSettingsChangeRequest[]
  tenantCreationRequests TenantCreationRequest[]
  schoolsCreated         Tenant[]
  notificationDismissals PlatformNotificationDismissal[]
  ticketsAssigned        PlatformTicketEscalation[]
  financeEntries         PlatformFinanceEntry[]
}

model PlatformRefreshToken {
  id             String       @id @default(uuid())
  tokenHash      String       @unique
  platformUserId String
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id])
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
}

model PlatformAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// Subscription billing — a school's recurring fee for one billing period. Amounts are whole KES
// (Int), same convention as the tenant-side Finance module. Issued manually by the Super Admin, not
// by a scheduled job (see Tenant.billingCycle comment).
model PlatformInvoice {
  id            String                 @id @default(uuid())
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  billingCycle  BillingCycle
  periodStart   DateTime
  periodEnd     DateTime
  amount        Int
  status        PlatformInvoiceStatus  @default(PENDING)
  dueDate       DateTime
  invoiceNumber String                 @unique
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  payments     PlatformPayment[]
  stkRequests  PlatformMpesaStkRequest[]
  paymentProofs PlatformPaymentProof[]
}

// Recording a payment that reaches the invoice amount marks it PAID, pushes the tenant's
// currentPeriodEnd out to the invoice's periodEnd, and reactivates the tenant if it had been
// SUSPENDED for non-payment — see TenantsService.recordPayment(). recordedByUserId is null for
// payments applied automatically by the M-Pesa STK callback (no Super Admin "recorded" those) —
// see ActivationService; the UI shows "via M-Pesa (self-service)" in that case.
model PlatformPayment {
  id               String                 @id @default(uuid())
  invoiceId        String
  invoice          PlatformInvoice        @relation(fields: [invoiceId], references: [id])
  amount           Int
  method           PlatformPaymentMethod
  reference        String?
  receiptNumber    String                 @unique
  recordedByUserId String?
  recordedBy       PlatformUser?          @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime               @default(now())
}

// One M-Pesa STK push attempt against an activation invoice (see ActivationService). Tracked
// separately from PlatformPayment so a failed/cancelled/timed-out push (common with STK — the
// user closes the prompt, has insufficient funds, etc.) doesn't need a payment row at all; only a
// successful callback creates one. checkoutRequestId is how Safaricom's async callback is matched
// back to the original request.
model PlatformMpesaStkRequest {
  id                String          @id @default(uuid())
  invoiceId         String
  invoice           PlatformInvoice @relation(fields: [invoiceId], references: [id])
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  phone             String
  amount            Int
  checkoutRequestId String          @unique
  merchantRequestId String?
  status            MpesaStkStatus  @default(PENDING)
  mpesaReceiptNumber String?
  resultDesc        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// Singleton (always id="platform") — the platform's own bank/paybill details for receiving
// activation payments, shown on the public activation page when a school picks Bank/Paybill
// instead of STK push. Distinct from Tenant.bankName/mpesaPaybill, which is a school's own
// fee-collection config for its parents, not the platform's own receiving account.
model PlatformSettings {
  id                String   @id @default("platform")
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  paybillNumber     String?
  paybillAccountName String?
  // Feature toggles — nothing about which channels/payment methods are available should be
  // hardcoded; a Super Admin can turn any of these off without touching config files. Changing any
  // of these (and the two reminder-window fields below) goes through the OTP-gated
  // request/confirm flow — see PlatformSettingsChangeRequest.
  smsEnabled          Boolean @default(true)
  emailEnabled        Boolean @default(true)
  stkEnabled          Boolean @default(true)
  bankTransferEnabled Boolean @default(true)
  paybillEnabled      Boolean @default(true)
  // How many days before a deadline RemindersService's daily job sends the corresponding reminder.
  demoReminderDaysBefore    Int @default(2)
  renewalReminderDaysBefore Int @default(5)
  // Third-party API credentials — DB-backed so a Super Admin can change them from the UI (OTP-gated,
  // same as everything else on this model) without editing server env vars and redeploying. Each
  // provider resolves `dbValue ?? envValue` at call time, so env vars remain a working fallback for
  // local dev / initial setup. Secret-bearing fields are never returned in full by GET
  // /platform/settings — see PlatformSettingsService.getMaskedForClient().
  mpesaEnv            String?
  mpesaConsumerKey    String?
  mpesaConsumerSecret String?
  mpesaShortcode      String?
  mpesaPasskey        String?
  mpesaCallbackUrl    String?
  resendApiKey        String?
  resendFromAddress   String?
  advantaApiKey       String?
  advantaPartnerId    String?
  advantaSenderId     String?
  // Platform-wide branding shown on the public login page only — never per-school (each school's
  // own branding is on Tenant.logoUrl/primaryColor etc., untouched by this).
  systemName          String?
  loginTagline        String?
  loginSubtitle       String?
  // Fully dynamic login-page identity: an uploaded image (via the existing /uploads endpoint,
  // same pattern as a school's own logo) shown instead of the built-in icon, a browser-tab
  // favicon, and every remaining piece of copy on the page — each falls back to a sensible
  // built-in default in the frontend when unset (see login/page.tsx's DEFAULT_BRANDING).
  loginLogoUrl        String?
  faviconUrl          String?
  loginHeading         String?
  loginHelperText      String?
  loginFooterText      String?
  builtByText          String?
  updatedAt         DateTime @updatedAt
}

// Named, customizable copy for every message the platform sends (see PlatformNotifierService). A
// row only exists once a Super Admin has customized that key — its absence means "use the built-in
// default" (see default-templates.ts), and deleting/clearing a row is how "reset to default" works.
// Keys are plain strings (not an enum) so new touchpoints can be added without a migration.
model PlatformMessageTemplate {
  key       String   @id
  subject   String?
  emailBody String?
  smsBody   String?
  updatedAt DateTime @updatedAt
}

// Generalizes the two-code tenant-creation gate (see TenantCreationRequest) to platform config
// changes: a Super Admin proposes an edit, a 6-digit code is sent to their own email/phone, and
// only confirming that code applies it — same reasoning (a compromised/unattended session can't
// silently alter platform-wide payment config or messaging). One shared request/confirm flow backs
// both PlatformSettings edits and PlatformMessageTemplate edits; `scope` tells the confirm step
// which service to apply `changes` through.
model PlatformSettingsChangeRequest {
  id            String       @id @default(uuid())
  requestedById String
  requestedBy   PlatformUser @relation(fields: [requestedById], references: [id])
  scope         String
  changes       Json
  code          String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime     @default(now())
}

// One submission from the short survey linked in a demo's expiry reminder (see RemindersService /
// FeedbackController). Public, unauthenticated submission — same signed-token pattern as the
// activation link, scoped to exactly one tenant.
model TenantFeedback {
  id                      String   @id @default(uuid())
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id])
  rating                  Int?
  improvements            String?
  interestedInRealAccount Boolean?
  // Which survey this came from — the original demo-expiry nudge, or a post-support-ticket
  // satisfaction check. Both share this one model/public-submit flow; only the token payload and
  // the page copy differ per context. Defaults to DEMO_EXPIRY since that's the original use case.
  context                 FeedbackContext @default(DEMO_EXPIRY)
  ticketEscalationId      String?
  ticketEscalation        PlatformTicketEscalation? @relation(fields: [ticketEscalationId], references: [id])
  createdAt               DateTime @default(now())
}

// A school's claim of having paid by Bank/Paybill (no automatic API confirmation exists for
// these methods, unlike M-Pesa STK's webhook) — pasted from the activation page. Never
// auto-trusted: a Super Admin must approve before the invoice/tenant change, exactly like the
// pre-existing manual "Record payment" action. extractedAmount/extractedReference are a
// best-effort regex read of the pasted message, shown to the reviewer as a convenience only.
model PlatformPaymentProof {
  id                 String              @id @default(uuid())
  invoiceId          String
  invoice            PlatformInvoice     @relation(fields: [invoiceId], references: [id])
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  method             PaymentProofMethod
  rawMessage         String
  extractedAmount    Int?
  extractedReference String?
  status             PaymentProofStatus  @default(PENDING_REVIEW)
  reviewedByUserId   String?
  reviewedBy         PlatformUser?       @relation(fields: [reviewedByUserId], references: [id])
  reviewNote         String?
  createdAt          DateTime            @default(now())
  reviewedAt         DateTime?
}

// Every failed login attempt, both realms — a school's own login (tenantSlug set) and the Super
// Admin's own login (tenantSlug null). Kept as individual rows (not just a counter) so a burst can be
// windowed by createdAt without extra bookkeeping, and so the raw attempts are themselves an audit
// trail if ever needed.
model FailedLoginAttempt {
  id         String   @id @default(uuid())
  email      String
  tenantSlug String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([email, tenantSlug, createdAt])
}

enum SecurityAlertSeverity {
  LOW
  MEDIUM
  HIGH
}

// Raised once a burst of failed logins for the same (email, realm) crosses a threshold within a
// rolling window (see AuthService) — not one alert per failed attempt, which would just be noise.
// Super-Admin-visible only; there is no tenant-side view of this.
model SecurityAlert {
  id            String                 @id @default(uuid())
  type          String
  severity      SecurityAlertSeverity  @default(MEDIUM)
  email         String?
  tenantSlug    String?
  ipAddress     String?
  attemptCount  Int?
  details       String?
  acknowledged  Boolean                @default(false)
  createdAt     DateTime               @default(now())
}

// Time-delayed, per-school audit-log access. A Super Admin can't just click into a school's raw
// activity log — they request it, a 6-digit code is emailed to *their own* account (same consent
// pattern as TenantCreationRequest), and only once confirmed does a mandatory delay start; the log
// file itself isn't assembled/downloadable until availableAt passes. This is a deliberate friction —
// even a compromised or unattended Super Admin session can't pull a school's full activity history
// on the spot. Always scoped to exactly one tenant; there is no "all schools" export.
model AuditLogAccessRequest {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  requestedById  String
  requestedBy    PlatformUser @relation(fields: [requestedById], references: [id])
  code           String
  codeExpiresAt  DateTime
  confirmedAt    DateTime?
  availableAt    DateTime?
  downloadedAt   DateTime?
  sharedWithSchoolAt DateTime?
  createdAt      DateTime  @default(now())
}

// Platform-side notification bell — a computed feed, not a persisted table (mirrors the tenant-side
// NotificationDismissal in apps/api/prisma/tenant/schema.prisma exactly). "Read" state is tracked by
// snapshotting the item's message text at dismiss time; if the underlying count changes, the message
// no longer matches the snapshot and the item automatically reappears as unread.
model PlatformNotificationDismissal {
  id          String   @id @default(uuid())
  userId      String
  user        PlatformUser @relation(fields: [userId], references: [id])
  notifKey    String
  snapshot    String
  dismissedAt DateTime @default(now())

  @@unique([userId, notifKey])
}

enum PlatformTicketStatus {
  PENDING
  ASSIGNED
  RESOLVED
}

// Created only when a School Administrator escalates a ticket — routine tickets they resolve
// internally never touch this table at all (they stay entirely in that school's own tenant schema,
// see Ticket/TicketComment in apps/api/prisma/tenant/schema.prisma). This gives the Super Admin a
// fast, single-table cross-school list of only what actually needs platform attention, instead of
// fanning a query out across every tenant schema. The full conversation thread is fetched live via
// TenantPrismaService.forSchema() when a Super Admin/Sub-Admin opens one — see
// AuditLogAccessService.assembleCsv() for the exact precedent this follows.
model PlatformTicketEscalation {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  ticketId         String   // Ticket.id in that tenant's own schema — no cross-schema FK possible
  subject          String   // denormalized at escalation time so list views don't need a forSchema() round trip
  category         String
  priority         String
  submitterName    String
  escalationReason String
  status           PlatformTicketStatus @default(PENDING)
  assignedToId     String?
  assignedTo       PlatformUser? @relation(fields: [assignedToId], references: [id])
  resolutionNote   String?
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  feedback         TenantFeedback[]
}

// A manual money-in/money-out log (salaries, hosting costs, one-off revenue not captured by
// PlatformPayment, etc.) — deliberately separate from PlatformPayment (school activation/renewal
// revenue), not a replacement for it. FinanceService.overview() combines both sources for the
// platform's real "how much do we make" figure. Editable by SUPER_ADMIN and ASSISTANT_SUPER_ADMIN.
model PlatformFinanceEntry {
  id              String            @id @default(uuid())
  type            FinanceEntryType
  category        String
  amount          Int
  description     String?
  recordedByUserId String
  recordedBy      PlatformUser      @relation(fields: [recordedByUserId], references: [id])
  createdAt       DateTime          @default(now())
}

// One row per activation-fee headcount range (e.g. "1-100 people: KES 5,000"). Managed as a full
// list replace (delete-all + recreate) from the Pricing Tiers settings tab, not per-row CRUD — see
// PricingTiersService. maxHeadcount null means "no upper bound" (the top-open tier). The fee for a
// real (non-demo) school is always computed server-side from these via computeFee(), never trusted
// from the client — see TenantsService.requestCreate().
model PricingTier {
  id            String   @id @default(uuid())
  minHeadcount  Int
  maxHeadcount  Int?
  priceKes      Decimal
  // Storage cap (MB) auto-assigned to Tenant.storageLimitMbOverride when a real school lands in
  // this tier at creation — see TenantsService.confirmCreate(). Null means "no cap at this tier".
  storageLimitMb Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
