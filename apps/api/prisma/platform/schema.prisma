generator client {
  provider = "prisma-client-js"
  output   = "../../generated/platform-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  // Real (non-demo) school created but not yet paid for — login is blocked until the activation
  // fee is paid via M-Pesa STK push. See TenantsService.confirmCreate() and AuthService.login().
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
}

enum MpesaStkStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PlatformRole {
  SUPER_ADMIN
  // Sits above SUB_ADMIN: can create schools (self-confirms their own OTP, unlike SUB_ADMIN — see
  // TenantsService.requestCreate()'s isSubAdmin branch) and record finance ledger entries, but is
  // blocked from Security, Backups, Audit Logs, Platform Settings, Message Templates, Admins
  // management, and Tickets — same RequirePlatformRole gates as SUB_ADMIN, plus finance access.
  ASSISTANT_SUPER_ADMIN
  // Delegated admin: can create schools (still gated by an OTP sent to a real SUPER_ADMIN, never to
  // themselves — see TenantsService.requestCreate()) and view revenue/earnings, but is blocked from
  // Security, Backups, Audit Logs, Platform Settings, and Message Templates — see
  // RequirePlatformRole('SUPER_ADMIN') usages.
  SUB_ADMIN
  // A much more restricted role than the three admin tiers above: scoped only to the training
  // portal (their own assignment, daily registers, progress reports, resources, meetings) — never
  // implicitly included by a bare @RequirePlatformRole() (see PermissionsGuard's ADMIN_TIER_ROLES
  // whitelist); every endpoint a trainer should reach names 'TRAINER' explicitly.
  TRAINER
  // Someone the Super Admin has personally hired/assigned to manage an outside account or gig —
  // nothing to do with Hamzone's own business, see HamzoneOutreachEntry's doc comment (that money
  // is explicitly personal, never folded into PlatformFinanceService's company totals). Scoped only
  // to reporting earnings/challenges against outreach entries assigned to them; excluded from every
  // bare @RequirePlatformRole() route the same way TRAINER is.
  GIG_WORKER
  // Hired through the Recruitment module into a development role — scoped to their own assigned
  // HamzoneStaffTask rows (repo/task assignments), excluded from every bare @RequirePlatformRole()
  // route the same way TRAINER/GIG_WORKER are.
  SOFTWARE_ENGINEER
  // Generic catch-all for any other hired role the Recruitment module doesn't have a dedicated tier
  // for yet ("so many others") — same restricted, task-scoped standing as SOFTWARE_ENGINEER. The
  // specific job title lives on HamzoneJobPosition/PlatformUser, this is just the access tier.
  STAFF
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum FinanceEntryType {
  IN
  OUT
}

enum FeedbackContext {
  DEMO_EXPIRY
  TICKET_RESOLUTION
}

enum BillingCycle {
  MONTHLY
  HALF_YEARLY
  YEARLY
}

enum PlatformInvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PlatformPaymentMethod {
  BANK
  MPESA
  CASH
  PAYBILL
}

enum PaymentProofMethod {
  BANK
  PAYBILL
}

enum PaymentProofStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model SubscriptionPlan {
  id              String   @id @default(uuid())
  name            String   @unique
  maxStudents     Int
  maxStaff        Int
  storageLimitMb  Int
  priceMonthlyKes Decimal  @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenants Tenant[]
}

model Tenant {
  id                     String            @id @default(uuid())
  name                   String
  slug                   String            @unique
  schemaName             String            @unique
  logoUrl                String?
  primaryColor           String?           @default("#2563eb")
  // App reskin: sidebar background + main content-pane background. Text color is never stored —
  // the frontend derives readable foreground/hover/active/border shades from these at render time
  // (apps/web/src/lib/theme-color.ts), so a school can't accidentally pick a color that makes its
  // own sidebar unreadable. Null means "use the app default" (white sidebar, slate-50 content).
  sidebarColor           String?
  contentBgColor         String?
  address                String?
  // County is constrained client/server-side to Kenya's 47 official counties (see
  // apps/api/src/common/kenya-counties.ts) but stored as a plain string, not a Prisma enum, so the
  // list can be extended without a migration. Town is free text (county alone is precise enough for
  // grouping/reporting; town is just a helpful label for follow-ups).
  county                 String?
  town                   String?
  website                String?
  smsSenderId            String?
  // Captured from the creation request so the platform can reach the school directly (activation
  // link, "you're now active" notice, future billing reminders) without depending on the tenant's
  // own schema — which doesn't exist yet, or isn't queryable, before activation.
  contactEmail           String?
  contactPhone           String?
  // Editable by the School Administrator via the tenant-scoped Settings module — pure branding,
  // no financial/PII sensitivity, so no reason to route it through the Super Admin.
  mission                String?
  vision                 String?
  motto                  String?
  // Report-card pass/fail coloring threshold (numeric scores only — CBC rubric levels use a fixed
  // EE/ME=green, AE=amber, BE=red mapping instead). Same trust boundary as mission/vision/motto.
  passMarkPercent        Int               @default(50)
  // Editable by the Super Admin only (platform/tenants endpoints) — payment credentials are a
  // platform-level concern, same trust boundary as subscriptionPlan/status/storage limits.
  mpesaPaybill           String?
  bankName               String?
  bankAccountName        String?
  bankAccountNumber      String?
  status                 TenantStatus      @default(TRIAL)
  storageLimitMbOverride Int?
  subscriptionPlanId     String?
  subscriptionPlan       SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  // Billing: manually invoiced by the Super Admin (no scheduled job in this environment generates
  // renewal invoices automatically — see docs/SRS.md §4.1). currentPeriodEnd drives the renewal
  // countdown shown on the Super Admin dashboard; recording a payment against an invoice extends it
  // and reactivates a SUSPENDED tenant automatically (see TenantsService.recordPayment()).
  billingCycle           BillingCycle      @default(MONTHLY)
  currentPeriodEnd       DateTime?
  // First-login onboarding: false until the School Administrator saves the Settings page once
  // (branding/payment review, password change prompt lives client-side). Drives a forced redirect
  // to /school/settings so a freshly-provisioned school doesn't skip setup.
  settingsConfigured     Boolean           @default(false)
  // Demo/trial accounts created by the Super Admin with a time-boxed expiry (hours or days, chosen
  // at creation). Enforced live at login (same check as SUSPENDED) — no background job expires it,
  // since this environment has no scheduler; see docs/SRS.md §4.1.
  isDemo                 Boolean           @default(false)
  demoExpiresAt          DateTime?
  // Disposable variant of a demo account — same expiry/reminder/feedback machinery as isDemo
  // (always true alongside isDemo), the only difference is a delete button in the UI and a distinct
  // "TEST" badge. Deletion is hard-guarded server-side to isTest tenants only, regardless of caller
  // — see TenantsService.deleteTestTenant().
  isTest                 Boolean           @default(false)
  // Dedupe flags for RemindersService's daily job — set once a reminder fires so it isn't re-sent
  // every day of the window; renewalReminderSentAt is cleared back to null whenever currentPeriodEnd
  // moves forward (a new payment clears the way for the next cycle's reminder).
  demoReminderSentAt     DateTime?
  renewalReminderSentAt  DateTime?
  // Which Super Admin/Sub-Admin actually created this school — nullable since it can't be backfilled
  // for tenants created before this field existed unless a matching TenantCreationRequest exists
  // (see the migration's data-backfill UPDATE).
  createdById            String?
  createdBy              PlatformUser?     @relation(fields: [createdById], references: [id])
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?

  invoices PlatformInvoice[]
  auditLogAccessRequests AuditLogAccessRequest[]
  userDirectoryEntries UserDirectoryEntry[]
  mpesaStkRequests PlatformMpesaStkRequest[]
  paymentProofs PlatformPaymentProof[]
  feedback TenantFeedback[]
  ticketEscalations PlatformTicketEscalation[]
  campaignRecipients CampaignRecipient[]
  hamzoneClients     HamzoneClient[]
}

// Global email → school lookup, kept in sync whenever a tenant-side User is created (see
// UserDirectoryService). Lets login resolve which school an email belongs to without the user
// having to type a school slug — see AuthService.login(). Enforces email uniqueness across the
// whole platform (not just within one school) as a side effect: two schools can never register the
// same person's email independently.
model UserDirectoryEntry {
  id        String   @id @default(uuid())
  email     String   @unique
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// Two-step tenant creation: the Super Admin submits the school details, a 6-digit code is sent to
// their own registered email/phone (platform email/SMS stubs — logs instead of sending, same
// pattern as every other provider in this app), and only submitting that code actually creates the
// tenant. This prevents a compromised or unattended Super Admin session from silently provisioning
// schools.
model TenantCreationRequest {
  id             String    @id @default(uuid())
  name           String
  slug           String
  code           String
  // Second, independent verification: proves the phone number given for the new admin is real and
  // that person consents, alongside (not instead of) the Super Admin's own code above. Sent via SMS
  // to adminPhone at request time — see TenantsService.requestCreate()/confirmCreate().
  adminOtpCode      String
  adminOtpVerifiedAt DateTime?
  requestedById  String
  requestedBy    PlatformUser @relation(fields: [requestedById], references: [id])
  adminFullName     String
  adminEmail        String
  adminPhone        String
  adminPasswordHash String
  planId            String?
  // Demo/trial requests: isDemo + demoDurationHours (from the Super Admin's day/hour picker) get
  // applied to the resulting Tenant on confirmation — see TenantsService.confirmCreate().
  isDemo            Boolean   @default(false)
  // Disposable variant of a demo request — see Tenant.isTest's doc comment. Always paired with
  // isDemo: true when set.
  isTest            Boolean   @default(false)
  demoDurationHours Int?
  // One-time activation fee the Super Admin sets for this specific school (not tied to the
  // recurring subscriptionPlan price) — required for non-demo requests. Becomes the amount on the
  // first PlatformInvoice, paid via M-Pesa STK push before the school can log in.
  activationFeeKes  Decimal?
  // Which billing period the activation fee covers — chosen alongside the fee for non-demo
  // requests, used to compute the first PlatformInvoice's periodEnd and the Tenant's own
  // billingCycle at creation (previously hardcoded to 30 days / MONTHLY regardless of this field).
  activationBillingCycle BillingCycle?
  // Expected headcount for non-demo requests — drives the server-computed activationFeeKes via
  // PricingTiersService.computeFee() (the client never supplies the fee directly). Nullable since
  // demo/test requests never set these.
  studentCount           Int?
  teacherCount           Int?
  nonTeachingStaffCount  Int?
  // Storage cap (MB) from the PricingTier that matched the headcount above at request time —
  // applied to Tenant.storageLimitMbOverride on confirmation. Null means the matched tier had no
  // cap configured.
  storageLimitMb         Int?
  // Carried through to the resulting Tenant on confirmation — see TenantsService.confirmCreate().
  county            String?
  town              String?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
}

model PlatformUser {
  id               String    @id @default(uuid())
  email            String    @unique
  // Used to SMS the school-creation confirmation code (alongside email) and other admin alerts.
  // Seeded from SUPER_ADMIN_PHONE — see prisma/seed.ts.
  phone            String?
  // Where a Sub-Admin/Assistant Super Admin's restricted "contact Billing/Partnerships/Info"
  // messages appear to come from and get replied to — distinct from `email` (their login identity).
  // Falls back to `email` when unset. See MailboxesService.contact()/mailbox-keys.ts.
  contactEmail     String?
  passwordHash     String
  fullName         String
  avatarUrl        String?
  role             PlatformRole @default(SUPER_ADMIN)
  // The role this account was originally created/hired as — set once at creation, never touched by
  // later upgrades/downgrades, so a Super Admin can always "reset to default" a role they changed
  // experimentally without having to remember what it used to be. Null for the original seeded
  // Super Admin, whose "default" is simply whatever `role` already is.
  defaultRole      PlatformRole?
  // True immediately after an account is created with a system-generated temp password (trainers,
  // gig workers, recruitment hires, invited admins) — PermissionsGuard blocks every route except the
  // change-password/profile ones until this clears. Never set for the original seeded Super Admin.
  mustChangePassword Boolean @default(false)
  // Physical address — captured at creation for restricted-role accounts (trainer, gig worker,
  // recruitment hire) so the company knows roughly where someone is based.
  address          String?
  // Free-text job title shown alongside a STAFF-tier role, since STAFF is a deliberate catch-all
  // ("so many others") rather than a dedicated PlatformRole per position.
  jobTitle         String?
  gender           Gender?
  // Free-form team labels (e.g. "FRONTEND", "BACKEND", "DEVELOPER") a Super Admin can set on any
  // admin/trainer — not a role, just a tag HamzoneMeeting's audience targeting can match against so
  // "meeting for frontend and backend" doesn't need a new PlatformRole per team.
  teamTags         String[]  @default([])
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  refreshTokens    PlatformRefreshToken[]
  paymentsRecorded PlatformPayment[]
  auditLogAccessRequests AuditLogAccessRequest[]
  paymentProofsReviewed PlatformPaymentProof[]
  settingsChangeRequests PlatformSettingsChangeRequest[]
  tenantCreationRequests TenantCreationRequest[]
  schoolsCreated         Tenant[]
  notificationDismissals PlatformNotificationDismissal[]
  ticketsAssigned        PlatformTicketEscalation[]
  financeEntries         PlatformFinanceEntry[]
  emailsSent             PlatformEmailMessage[]
  moduleGrants           PlatformAdminModuleGrant[]
  campaigns              Campaign[]
  campaignRecipients     CampaignRecipient[]
  hamzoneClientsCreated       HamzoneClient[]
  hamzoneClientNotes          HamzoneClientNote[]
  hamzoneInvoicesCreated      HamzoneInvoice[]
  hamzoneTrainingRecords      HamzoneTrainingRecord[]
  hamzoneMarketingLeads       HamzoneMarketingLead[]
  hamzoneDocumentsUploaded    HamzoneDocument[] @relation("DocumentUploadedBy")
  hamzoneDocumentsSuggested   HamzoneDocument[] @relation("DocumentSuggestedBy")
  hamzoneApiKeysCreated       HamzoneApiKey[]
  trainingCentersHeaded       HamzoneTrainingCenter[] @relation("TrainingCenterHead")
  trainingCentersCreated      HamzoneTrainingCenter[] @relation("TrainingCenterCreatedBy")
  trainerProfile              HamzoneTrainerProfile?
  trainingProgramsCreated     HamzoneTrainingProgram[]
  meetingsCreated             HamzoneMeeting[]
  outreachEntriesCreated      HamzoneOutreachEntry[] @relation("OutreachCreatedBy")
  outreachEntriesAssigned     HamzoneOutreachEntry[] @relation("OutreachAssignedTo")
  outreachEarningsRecorded    HamzoneOutreachEarning[]
  jobPositionsCreated         HamzoneJobPosition[]
  jobApplicationsHired        HamzoneJobApplication[] @relation("JobApplicationHiredUser")
  staffTasksAssigned          HamzoneStaffTask[] @relation("StaffTaskAssignedTo")
  staffTasksCreated           HamzoneStaffTask[] @relation("StaffTaskAssignedBy")
}

model PlatformRefreshToken {
  id             String       @id @default(uuid())
  tokenHash      String       @unique
  platformUserId String
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id])
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
}

model PlatformAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// Subscription billing — a school's recurring fee for one billing period. Amounts are whole KES
// (Int), same convention as the tenant-side Finance module. Issued manually by the Super Admin, not
// by a scheduled job (see Tenant.billingCycle comment).
model PlatformInvoice {
  id            String                 @id @default(uuid())
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  billingCycle  BillingCycle
  periodStart   DateTime
  periodEnd     DateTime
  amount        Int
  status        PlatformInvoiceStatus  @default(PENDING)
  dueDate       DateTime
  invoiceNumber String                 @unique
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  payments     PlatformPayment[]
  stkRequests  PlatformMpesaStkRequest[]
  paymentProofs PlatformPaymentProof[]
}

// Recording a payment that reaches the invoice amount marks it PAID, pushes the tenant's
// currentPeriodEnd out to the invoice's periodEnd, and reactivates the tenant if it had been
// SUSPENDED for non-payment — see TenantsService.recordPayment(). recordedByUserId is null for
// payments applied automatically by the M-Pesa STK callback (no Super Admin "recorded" those) —
// see ActivationService; the UI shows "via M-Pesa (self-service)" in that case.
model PlatformPayment {
  id               String                 @id @default(uuid())
  invoiceId        String
  invoice          PlatformInvoice        @relation(fields: [invoiceId], references: [id])
  amount           Int
  method           PlatformPaymentMethod
  reference        String?
  receiptNumber    String                 @unique
  recordedByUserId String?
  recordedBy       PlatformUser?          @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime               @default(now())
}

// One M-Pesa STK push attempt against an activation invoice (see ActivationService). Tracked
// separately from PlatformPayment so a failed/cancelled/timed-out push (common with STK — the
// user closes the prompt, has insufficient funds, etc.) doesn't need a payment row at all; only a
// successful callback creates one. checkoutRequestId is how Safaricom's async callback is matched
// back to the original request.
model PlatformMpesaStkRequest {
  id                String          @id @default(uuid())
  invoiceId         String
  invoice           PlatformInvoice @relation(fields: [invoiceId], references: [id])
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  phone             String
  amount            Int
  checkoutRequestId String          @unique
  merchantRequestId String?
  status            MpesaStkStatus  @default(PENDING)
  mpesaReceiptNumber String?
  resultDesc        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// Singleton (always id="platform") — the platform's own bank/paybill details for receiving
// activation payments, shown on the public activation page when a school picks Bank/Paybill
// instead of STK push. Distinct from Tenant.bankName/mpesaPaybill, which is a school's own
// fee-collection config for its parents, not the platform's own receiving account.
model PlatformSettings {
  id                String   @id @default("platform")
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  paybillNumber     String?
  paybillAccountName String?
  // Feature toggles — nothing about which channels/payment methods are available should be
  // hardcoded; a Super Admin can turn any of these off without touching config files. Changing any
  // of these (and the two reminder-window fields below) goes through the OTP-gated
  // request/confirm flow — see PlatformSettingsChangeRequest.
  smsEnabled          Boolean @default(true)
  emailEnabled        Boolean @default(true)
  stkEnabled          Boolean @default(true)
  bankTransferEnabled Boolean @default(true)
  paybillEnabled      Boolean @default(true)
  // How many days before a deadline RemindersService's daily job sends the corresponding reminder.
  demoReminderDaysBefore    Int @default(2)
  renewalReminderDaysBefore Int @default(5)
  // Third-party API credentials — DB-backed so a Super Admin can change them from the UI (OTP-gated,
  // same as everything else on this model) without editing server env vars and redeploying. Each
  // provider resolves `dbValue ?? envValue` at call time, so env vars remain a working fallback for
  // local dev / initial setup. Secret-bearing fields are never returned in full by GET
  // /platform/settings — see PlatformSettingsService.getMaskedForClient().
  mpesaEnv            String?
  mpesaConsumerKey    String?
  mpesaConsumerSecret String?
  mpesaShortcode      String?
  mpesaPasskey        String?
  mpesaCallbackUrl    String?
  resendApiKey        String?
  resendFromAddress   String?
  advantaApiKey       String?
  advantaPartnerId    String?
  advantaSenderId     String?
  // Platform-wide branding shown on the public login page only — never per-school (each school's
  // own branding is on Tenant.logoUrl/primaryColor etc., untouched by this).
  systemName          String?
  loginTagline        String?
  loginSubtitle       String?
  // Fully dynamic login-page identity: an uploaded image (via the existing /uploads endpoint,
  // same pattern as a school's own logo) shown instead of the built-in icon, a browser-tab
  // favicon, and every remaining piece of copy on the page — each falls back to a sensible
  // built-in default in the frontend when unset (see login/page.tsx's DEFAULT_BRANDING).
  loginLogoUrl        String?
  faviconUrl          String?
  loginHeading         String?
  loginHelperText      String?
  loginFooterText      String?
  builtByText          String?
  // Real, editable contact details shown on invoice PDFs (both PlatformInvoice and HamzoneInvoice) —
  // replaces what used to be a hardcoded phone/website string baked into the PDF-drawing code.
  supportPhone      String?
  supportWebsite    String?
  billingEmail      String?
  updatedAt         DateTime @updatedAt
}

// Named, customizable copy for every message the platform sends (see PlatformNotifierService). A
// row only exists once a Super Admin has customized that key — its absence means "use the built-in
// default" (see default-templates.ts), and deleting/clearing a row is how "reset to default" works.
// Keys are plain strings (not an enum) so new touchpoints can be added without a migration.
model PlatformMessageTemplate {
  key       String   @id
  subject   String?
  emailBody String?
  smsBody   String?
  updatedAt DateTime @updatedAt
}

// Generalizes the two-code tenant-creation gate (see TenantCreationRequest) to platform config
// changes: a Super Admin proposes an edit, a 6-digit code is sent to their own email/phone, and
// only confirming that code applies it — same reasoning (a compromised/unattended session can't
// silently alter platform-wide payment config or messaging). One shared request/confirm flow backs
// both PlatformSettings edits and PlatformMessageTemplate edits; `scope` tells the confirm step
// which service to apply `changes` through.
model PlatformSettingsChangeRequest {
  id            String       @id @default(uuid())
  requestedById String
  requestedBy   PlatformUser @relation(fields: [requestedById], references: [id])
  scope         String
  changes       Json
  code          String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime     @default(now())
}

// One submission from the short survey linked in a demo's expiry reminder (see RemindersService /
// FeedbackController). Public, unauthenticated submission — same signed-token pattern as the
// activation link, scoped to exactly one tenant.
model TenantFeedback {
  id                      String   @id @default(uuid())
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id])
  rating                  Int?
  improvements            String?
  interestedInRealAccount Boolean?
  // Which survey this came from — the original demo-expiry nudge, or a post-support-ticket
  // satisfaction check. Both share this one model/public-submit flow; only the token payload and
  // the page copy differ per context. Defaults to DEMO_EXPIRY since that's the original use case.
  context                 FeedbackContext @default(DEMO_EXPIRY)
  ticketEscalationId      String?
  ticketEscalation        PlatformTicketEscalation? @relation(fields: [ticketEscalationId], references: [id])
  createdAt               DateTime @default(now())
}

// A school's claim of having paid by Bank/Paybill (no automatic API confirmation exists for
// these methods, unlike M-Pesa STK's webhook) — pasted from the activation page. Never
// auto-trusted: a Super Admin must approve before the invoice/tenant change, exactly like the
// pre-existing manual "Record payment" action. extractedAmount/extractedReference are a
// best-effort regex read of the pasted message, shown to the reviewer as a convenience only.
model PlatformPaymentProof {
  id                 String              @id @default(uuid())
  invoiceId          String
  invoice            PlatformInvoice     @relation(fields: [invoiceId], references: [id])
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  method             PaymentProofMethod
  rawMessage         String
  extractedAmount    Int?
  extractedReference String?
  status             PaymentProofStatus  @default(PENDING_REVIEW)
  reviewedByUserId   String?
  reviewedBy         PlatformUser?       @relation(fields: [reviewedByUserId], references: [id])
  reviewNote         String?
  createdAt          DateTime            @default(now())
  reviewedAt         DateTime?
}

// Every failed login attempt, both realms — a school's own login (tenantSlug set) and the Super
// Admin's own login (tenantSlug null). Kept as individual rows (not just a counter) so a burst can be
// windowed by createdAt without extra bookkeeping, and so the raw attempts are themselves an audit
// trail if ever needed.
model FailedLoginAttempt {
  id         String   @id @default(uuid())
  email      String
  tenantSlug String?
  ipAddress  String?
  // Best-effort IP geolocation (see geo-ip.util.ts) — null when the lookup fails/times out or the
  // IP is private/unresolvable; a failed lookup must never block the login response itself.
  city       String?
  country    String?
  createdAt  DateTime @default(now())

  @@index([email, tenantSlug, createdAt])
}

// One row per successful login, either realm — the counterpart to FailedLoginAttempt. userId is a
// plain string (not a relation) since a tenant-realm login's user lives in that school's own schema,
// not this one — same cross-schema-reference-as-string precedent as PlatformTicketEscalation.ticketId.
// isNewDevice is computed at write time by checking whether this exact (userId, ipAddress, userAgent)
// combination has ever been seen before for this user — a coarse but zero-extra-infrastructure
// device fingerprint (no cookies/client-side ids needed).
model LoginEvent {
  id          String   @id @default(uuid())
  userId      String
  email       String
  realm       String
  tenantSlug  String?
  ipAddress   String?
  userAgent   String?
  city        String?
  country     String?
  isNewDevice Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// A Super Admin's per-admin override granting a specific Sub-Admin/Assistant Super Admin access to
// one otherwise-tier-restricted platform module (e.g. TICKETS, SECURITY) without changing their
// overall role tier — see PermissionsGuard, which ORs this against the tier-based check. `module` is
// a plain string (not an enum) so new grantable modules don't need a migration — see
// platform-modules.ts for the fixed, code-enforced set of valid keys.
model PlatformAdminModuleGrant {
  id        String       @id @default(uuid())
  userId    String
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  grantedAt DateTime     @default(now())

  @@unique([userId, module])
}

// Every outbound SMS attempt, both success and failure, across the whole system (platform notices
// AND tenant-side sends — see AdvantaSmsProvider.send(), the single shared provider both paths go
// through) — answers "how many SMS did we send today, how many failed" without needing per-tenant
// fan-out. Not linked to a specific tenant/user; `to` alone is enough for the aggregate counts this
// is built for.
model PlatformSmsLog {
  id                String   @id @default(uuid())
  to                String
  success           Boolean
  providerMessageId String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
}

enum SecurityAlertSeverity {
  LOW
  MEDIUM
  HIGH
}

// Raised once a burst of failed logins for the same (email, realm) crosses a threshold within a
// rolling window (see AuthService) — not one alert per failed attempt, which would just be noise.
// Super-Admin-visible only; there is no tenant-side view of this.
model SecurityAlert {
  id            String                 @id @default(uuid())
  type          String
  severity      SecurityAlertSeverity  @default(MEDIUM)
  email         String?
  tenantSlug    String?
  ipAddress     String?
  attemptCount  Int?
  details       String?
  acknowledged  Boolean                @default(false)
  createdAt     DateTime               @default(now())
}

// Time-delayed, per-school audit-log access. A Super Admin can't just click into a school's raw
// activity log — they request it, a 6-digit code is emailed to *their own* account (same consent
// pattern as TenantCreationRequest), and only once confirmed does a mandatory delay start; the log
// file itself isn't assembled/downloadable until availableAt passes. This is a deliberate friction —
// even a compromised or unattended Super Admin session can't pull a school's full activity history
// on the spot. Always scoped to exactly one tenant; there is no "all schools" export.
model AuditLogAccessRequest {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  requestedById  String
  requestedBy    PlatformUser @relation(fields: [requestedById], references: [id])
  code           String
  codeExpiresAt  DateTime
  confirmedAt    DateTime?
  availableAt    DateTime?
  downloadedAt   DateTime?
  sharedWithSchoolAt DateTime?
  createdAt      DateTime  @default(now())
}

// Platform-side notification bell — a computed feed, not a persisted table (mirrors the tenant-side
// NotificationDismissal in apps/api/prisma/tenant/schema.prisma exactly). "Read" state is tracked by
// snapshotting the item's message text at dismiss time; if the underlying count changes, the message
// no longer matches the snapshot and the item automatically reappears as unread.
model PlatformNotificationDismissal {
  id          String   @id @default(uuid())
  userId      String
  user        PlatformUser @relation(fields: [userId], references: [id])
  notifKey    String
  snapshot    String
  dismissedAt DateTime @default(now())

  @@unique([userId, notifKey])
}

enum PlatformTicketStatus {
  PENDING
  ASSIGNED
  RESOLVED
}

// Created only when a School Administrator escalates a ticket — routine tickets they resolve
// internally never touch this table at all (they stay entirely in that school's own tenant schema,
// see Ticket/TicketComment in apps/api/prisma/tenant/schema.prisma). This gives the Super Admin a
// fast, single-table cross-school list of only what actually needs platform attention, instead of
// fanning a query out across every tenant schema. The full conversation thread is fetched live via
// TenantPrismaService.forSchema() when a Super Admin/Sub-Admin opens one — see
// AuditLogAccessService.assembleCsv() for the exact precedent this follows.
model PlatformTicketEscalation {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  ticketId         String   // Ticket.id in that tenant's own schema — no cross-schema FK possible
  subject          String   // denormalized at escalation time so list views don't need a forSchema() round trip
  category         String
  priority         String
  submitterName    String
  escalationReason String
  status           PlatformTicketStatus @default(PENDING)
  assignedToId     String?
  assignedTo       PlatformUser? @relation(fields: [assignedToId], references: [id])
  resolutionNote   String?
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  feedback         TenantFeedback[]
}

enum HamzoneProductLine {
  SCHOOL_ERP
  DTP_TRAINING
  CODING_ROBOTICS
  WEBSITES
  SACCO_SYSTEMS
  HOSPITAL_SYSTEMS
  OTHER
}

enum HamzoneClientType {
  INDIVIDUAL
  SCHOOL
  BUSINESS
}

enum HamzoneInvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum HamzoneTrainingTrack {
  FRONTEND
  BACKEND
  CODING_ROBOTICS
  OTHER
}

enum HamzoneTrainingStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HamzoneLeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

enum HamzoneLeadSource {
  ADMIN
  PUBLIC_API
}

enum HamzoneDocumentCategory {
  POSTER
  CERTIFICATE
  BROCHURE
  OTHER
}

// Hamzone Technologies' own company CRM — deliberately separate from the school-ERP's platform
// billing (PlatformInvoice/PlatformPayment, which is specifically the recurring subscription a
// school pays to use this system). A HamzoneClient can be a school that also uses the ERP
// (tenantId set, so "total clients" never double-counts them) or a standalone client of any other
// Hamzone product line (training, websites, SACCO systems, hospital systems) with no ERP presence
// at all. Revenue from HamzoneInvoice is folded into PlatformFinanceService.overview()'s totals —
// same company, one real "how much do we make" figure — see that service's doc comment.
model HamzoneClient {
  id               String                @id @default(uuid())
  name             String
  type             HamzoneClientType     @default(INDIVIDUAL)
  productLines     HamzoneProductLine[]
  // What "OTHER" means, when it's one of the selected productLines — never left unexplained.
  productLinesOther String?
  contactName      String?
  email            String?
  phone            String?
  // The client's own website/system/domain, if applicable (a hospital system, a SACCO portal, a
  // built website) — distinct from Tenant.website, which is a school's own public site, not this.
  systemUrl        String?
  domainActive     Boolean?
  nextPaymentDueAt DateTime?
  tenantId         String?
  tenant           Tenant?               @relation(fields: [tenantId], references: [id])
  createdByUserId  String
  createdBy        PlatformUser          @relation(fields: [createdByUserId], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  notes            HamzoneClientNote[]
  invoices         HamzoneInvoice[]
  trainingRecords  HamzoneTrainingRecord[]
}

// Call/meeting log — conversations, promises, and agreements made with a client, so nothing
// depends on one person's memory. Plain chronological list, same shape as TicketComment.
model HamzoneClientNote {
  id           String        @id @default(uuid())
  clientId     String
  client       HamzoneClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorUserId String
  author       PlatformUser  @relation(fields: [authorUserId], references: [id])
  body         String
  createdAt    DateTime      @default(now())

  @@index([clientId, createdAt])
}

// A company invoice for any Hamzone product line — VAT-inclusive (Kenya's standard rate, 16%,
// stored per-invoice rather than hardcoded so a future rate change or a specific exemption doesn't
// need a migration). Deliberately simpler than PlatformInvoice/PlatformPayment's split (no separate
// payments table, no M-Pesa STK integration) — a single "mark paid" action records the settlement
// directly on the row, since this is a manually-run company ledger, not a self-service payment flow.
model HamzoneInvoice {
  id               String               @id @default(uuid())
  invoiceNumber    String               @unique
  clientId         String
  client           HamzoneClient        @relation(fields: [clientId], references: [id])
  productLine      HamzoneProductLine
  purpose          String?
  description      String
  subtotal         Int
  vatRate          Int                  @default(16)
  vatAmount        Int
  total            Int
  status           HamzoneInvoiceStatus @default(PENDING)
  dueDate          DateTime
  paidAt           DateTime?
  paymentMethod    String?
  paymentReference String?
  emailSentAt      DateTime?
  smsSentAt        DateTime?
  emailStatus      CampaignDeliveryStatus @default(PENDING)
  smsStatus        CampaignDeliveryStatus @default(PENDING)
  emailError       String?
  smsError         String?
  createdByUserId  String
  createdBy        PlatformUser         @relation(fields: [createdByUserId], references: [id])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

// Who has trained with Hamzone (frontend/backend/coding & robotics), independent of whether
// they're linked to a paying HamzoneClient — a training cohort often includes people who haven't
// become clients yet. Exposed read-only to the public website via HamzoneApiKey.
model HamzoneTrainingRecord {
  id              String                 @id @default(uuid())
  clientId        String?
  client          HamzoneClient?         @relation(fields: [clientId], references: [id])
  // Which cohort/course run this trainee belongs to — nullable since standalone training records
  // predate HamzoneTrainingProgram and can still be created without one.
  programId       String?
  program         HamzoneTrainingProgram? @relation(fields: [programId], references: [id])
  traineeName     String
  traineeEmail    String?
  traineePhone    String?
  track           HamzoneTrainingTrack
  trackOther       String?
  status          HamzoneTrainingStatus  @default(ENROLLED)
  startedAt        DateTime?
  completedAt      DateTime?
  notes            String?
  createdByUserId  String
  createdBy        PlatformUser          @relation(fields: [createdByUserId], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

// Field-submitted by the marketing team (which every platform admin tier can act as, plus anyone
// specifically invited for it) the moment they get a lead — real-time, not end-of-day notes, so
// follow-ups don't go cold. Not a HamzoneClient yet; converts into one manually once qualified.
// submittedByUserId is nullable because a lead can also arrive from the public marketing-site
// contact form (see PublicCrmController's leads:write-scoped endpoint) with no logged-in admin
// behind it — `source` distinguishes the two without guessing from a null FK.
model HamzoneMarketingLead {
  id                String             @id @default(uuid())
  submittedByUserId String?
  submittedBy       PlatformUser?      @relation(fields: [submittedByUserId], references: [id])
  source            HamzoneLeadSource  @default(ADMIN)
  clientName        String
  contactPhone      String?
  contactEmail      String?
  interest          HamzoneProductLine
  interestOther     String?
  location          String?
  notes             String?
  followUpAt        DateTime?
  status            HamzoneLeadStatus  @default(NEW)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// Shareable company documents (posters, certificates, brochures) — stored via the existing
// /uploads pipeline (same as a school logo), listed here so anyone with dashboard access can find
// and share the link rather than hunting through email/WhatsApp history for the latest version.
model HamzoneDocument {
  id               String                   @id @default(uuid())
  title            String
  category         HamzoneDocumentCategory  @default(OTHER)
  categoryOther    String?
  fileUrl          String
  uploadedByUserId String
  uploadedBy       PlatformUser             @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  // Set when this is a training resource tied to a specific cohort ("leads can upload resources...
  // used by the trainers"). Null for general company documents (posters/certificates/brochures).
  trainingProgramId String?
  trainingProgram    HamzoneTrainingProgram? @relation(fields: [trainingProgramId], references: [id])
  // Set when a trainer suggested this addition themselves rather than a lead uploading it —
  // distinguishes "here's a resource" from "here's a resource I think we should add".
  suggestedByUserId String?
  suggestedBy       PlatformUser?           @relation("DocumentSuggestedBy", fields: [suggestedByUserId], references: [id])
  createdAt        DateTime                 @default(now())
}

// Lets Hamzone's own public website (or any other third-party system) pull select, non-sensitive
// CRM data — training records, document listings, client counts — without a human admin login
// session. Only the key's hash is stored (shown once at creation, same "never retrievable again"
// precedent as every other secret in this codebase); `scopes` gates exactly which read endpoints
// under /public/api/v1 the key can call — see HamzoneApiKeyGuard.
model HamzoneApiKey {
  id              String    @id @default(uuid())
  label           String
  keyHash         String    @unique
  keyPreview      String
  scopes          String[]
  createdByUserId String
  createdBy       PlatformUser @relation(fields: [createdByUserId], references: [id])
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
}

enum HamzoneTrainerStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum HamzoneProgramStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum HamzoneOutreachType {
  ACCOUNT_MANAGEMENT
  TASKING
  OUTLIER
  HANDSHAKE
  OTHER
}

enum HamzoneOutreachStatus {
  NEW
  ONBOARDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum HamzoneEarningPeriod {
  DAILY
  WEEKLY
}

// A physical or virtual location where Hamzone runs training — "this center has been assigned this
// person" (headUser) and "the number of students" (studentsCount) from the original request.
// Distinct from a School-ERP Tenant: a center is a training venue, not a paying school.
model HamzoneTrainingCenter {
  id              String        @id @default(uuid())
  name            String
  location        String?
  headUserId      String?
  headUser        PlatformUser? @relation("TrainingCenterHead", fields: [headUserId], references: [id])
  studentsCount   Int?
  notes           String?
  createdByUserId String
  createdBy       PlatformUser  @relation("TrainingCenterCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  programs        HamzoneTrainingProgram[]
  trainerProfiles HamzoneTrainerProfile[]
  trainerHistory  HamzoneTrainerCenterHistory[]
}

// One row per TRAINER-role PlatformUser — where they're assigned, what they're paid, and their
// contract window. Kept separate from PlatformUser itself (rather than bolting salary/contract
// fields onto it) since no other role has anything like this. contractDocumentUrl points at the
// auto-generated PDF (see trainer-contract-pdf.util.ts) — regenerated whenever the contract terms
// change, so it's always in sync with what's actually stored here, not a one-time snapshot.
model HamzoneTrainerProfile {
  id                  String                @id @default(uuid())
  userId              String                @unique
  user                PlatformUser          @relation(fields: [userId], references: [id])
  centerId            String?
  center              HamzoneTrainingCenter? @relation(fields: [centerId], references: [id])
  track               HamzoneTrainingTrack?
  trackOther          String?
  monthlySalaryKes    Int?
  contractStartDate   DateTime?
  contractEndDate     DateTime?
  contractDocumentUrl String?
  status              HamzoneTrainerStatus  @default(ACTIVE)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  programs            HamzoneTrainingProgram[]
  registers           HamzoneDailyRegister[]
  reports             HamzoneTrainerReport[]
  centerHistory       HamzoneTrainerCenterHistory[]
}

// History of every center a trainer has been assigned to, in sequence — "one trainer can be
// assigned to 5 or more centers consecutively." A new assignment always closes out the prior open
// row (endDate set) before opening a new one — see TrainersService.updateProfile().
model HamzoneTrainerCenterHistory {
  id        String                @id @default(uuid())
  trainerId String
  trainer   HamzoneTrainerProfile @relation(fields: [trainerId], references: [id])
  centerId  String
  center    HamzoneTrainingCenter @relation(fields: [centerId], references: [id])
  startDate DateTime              @default(now())
  endDate   DateTime?
  notes     String?
  createdAt DateTime              @default(now())

  @@index([trainerId, startDate])
}

// A cohort/course run with real start/end dates ("training dates from this to this") — the unit a
// trainer is assigned to and that trainees (HamzoneTrainingRecord, extended below with a nullable
// programId) enroll in.
model HamzoneTrainingProgram {
  id              String                 @id @default(uuid())
  title           String
  track           HamzoneTrainingTrack
  trackOther      String?
  centerId        String?
  center          HamzoneTrainingCenter? @relation(fields: [centerId], references: [id])
  trainerId       String?
  trainer         HamzoneTrainerProfile? @relation(fields: [trainerId], references: [id])
  startDate       DateTime
  endDate         DateTime
  description     String?
  status          HamzoneProgramStatus   @default(SCHEDULED)
  // What the cohort will build by the end of training (especially robotics) — captured early for
  // cost planning, with a submission deadline so trainers commit to a plan rather than deciding at
  // the last minute.
  plannedProjectDescription String?
  plannedProjectDueAt       DateTime?
  createdByUserId String
  createdBy       PlatformUser           @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  trainees        HamzoneTrainingRecord[]
  registers       HamzoneDailyRegister[]
  reports         HamzoneTrainerReport[]
  resources       HamzoneDocument[]
  roster          HamzoneTrainee[]
}

// A trainer's daily attendance + coverage log ("daily register of trainees... how things they have
// covered") — the record that's downloaded as a PDF and is the primary evidence of whether a
// trainer is actually running sessions.
model HamzoneDailyRegister {
  id              String                 @id @default(uuid())
  programId       String
  program         HamzoneTrainingProgram @relation(fields: [programId], references: [id])
  trainerId       String
  trainer         HamzoneTrainerProfile  @relation(fields: [trainerId], references: [id])
  date            DateTime
  // "Was there training today?" — No collapses everything below to just a reason; the daily-link
  // landing page asks this before showing the register at all. Defaults true for registers created
  // the old way (admin/trainer form, not the daily link), which always implied training happened.
  hadTrainingToday Boolean               @default(true)
  noTrainingReason String?
  traineesPresent Int                    @default(0)
  traineesTotal   Int                    @default(0)
  topicsCovered   String?
  notes           String?
  // Exactly two proof-of-attendance photos — enforced at the DTO/service layer, not the schema.
  photo1Url       String?
  photo2Url       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  attendance      HamzoneAttendanceRecord[]

  // One register per program per calendar day — the daily-link submission is always an upsert
  // against this key, which is also what makes "editable within the day, then locked" possible.
  @@unique([programId, date])
  @@index([programId, date])
}

enum HamzoneGender {
  MALE
  FEMALE
  OTHER
}

// The named trainee roster for a program — entered once (first time a register is ever marked for
// that program), then reused every day after by name, never just a headcount. portalEmail/Hash/
// Enabled back the lightweight self-service portal for adult (20+) learners — see
// TraineePortalService; left null/false for trainees who never get portal access.
model HamzoneTrainee {
  id                 String                 @id @default(uuid())
  programId          String
  program            HamzoneTrainingProgram @relation(fields: [programId], references: [id])
  fullName           String
  gender             HamzoneGender
  phone              String?
  address            String?
  age                Int?
  portalEmail        String?                @unique
  portalPasswordHash String?
  portalEnabled      Boolean                @default(false)
  createdAt          DateTime               @default(now())

  attendance         HamzoneAttendanceRecord[]

  @@index([programId])
}

// Per-trainee, per-day present/absent — replaces the old bare traineesPresent/traineesTotal
// headcount with real, name-verified attendance (traineesPresent/Total on HamzoneDailyRegister are
// kept as a denormalized convenience for the existing chart/PDF code, always derived from this).
model HamzoneAttendanceRecord {
  id         String               @id @default(uuid())
  registerId String
  register   HamzoneDailyRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  traineeId  String
  trainee    HamzoneTrainee       @relation(fields: [traineeId], references: [id])
  present    Boolean

  @@unique([registerId, traineeId])
}

// A trainer's periodic (weekly/monthly) check-in — progress narrative + challenges, distinct from
// the daily register's per-session attendance log. This is the "are they actually working" signal
// alongside the salary/contract fields on HamzoneTrainerProfile.
model HamzoneTrainerReport {
  id              String                  @id @default(uuid())
  trainerId       String
  trainer         HamzoneTrainerProfile   @relation(fields: [trainerId], references: [id])
  programId       String?
  program         HamzoneTrainingProgram? @relation(fields: [programId], references: [id])
  periodStart     DateTime
  periodEnd       DateTime
  progressSummary String
  challenges      String?
  createdAt       DateTime                @default(now())
}

// A scheduled meeting with a Zoom/Google-Meet link, communicated in-app and via SMS. Audience is
// resolved as the union of three independent selectors (mirrors the Campaign targeting pattern):
// specific role tiers, free-form team tags on PlatformUser (frontend/backend/developer/etc — see
// PlatformUser.teamTags), and specific named invitees.
model HamzoneMeeting {
  id               String       @id @default(uuid())
  title            String
  description      String?
  meetingLink      String?
  scheduledAt      DateTime
  audienceRoles    String[]
  audienceTeamTags String[]
  invitedUserIds   String[]
  createdByUserId  String
  createdBy        PlatformUser @relation(fields: [createdByUserId], references: [id])
  notifiedAt       DateTime?
  createdAt        DateTime     @default(now())
}

// A personal outreach/gig-management log — explicitly NOT Hamzone company business (see
// HamzoneOutreachEarning's doc comment on why its money is never folded into the company finance
// totals). One admin's private record of an external contact who handed them an account to manage
// or a task to run, who it's assigned to (a real PlatformUser — including a GIG_WORKER account
// created specifically for this — or just a name/phone for someone outside the system entirely),
// and which browser/anti-detect-browser profile the managed account logs in through.
model HamzoneOutreachEntry {
  id                      String                 @id @default(uuid())
  createdByUserId         String
  createdBy               PlatformUser           @relation("OutreachCreatedBy", fields: [createdByUserId], references: [id])
  contactName             String
  contactPhone            String?
  contactEmail            String?
  type                    HamzoneOutreachType    @default(OTHER)
  typeOther               String?
  status                  HamzoneOutreachStatus  @default(NEW)
  receivedAt              DateTime
  loginBrowser            String?
  assignedToUserId        String?
  assignedTo              PlatformUser?          @relation("OutreachAssignedTo", fields: [assignedToUserId], references: [id])
  assignedToExternalName  String?
  assignedToExternalPhone String?
  notes                   String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  earnings                HamzoneOutreachEarning[]
}

// Recurring income logged against one managed account/gig — deliberately kept out of
// PlatformFinanceService's company-wide revenue totals entirely (no join, no query references it
// there): this is the recording admin's own personal money, not Hamzone Technologies', per explicit
// instruction. recordedByUserId is whoever actually submitted this entry (the creator, or the
// assignee reporting their own earnings back in).
model HamzoneOutreachEarning {
  id               String               @id @default(uuid())
  entryId          String
  entry            HamzoneOutreachEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  period           HamzoneEarningPeriod
  periodDate       DateTime
  amount           Int
  challenges       String?
  notes            String?
  recordedByUserId String
  recordedBy       PlatformUser         @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime             @default(now())
}

// A manual money-in/money-out log (salaries, hosting costs, one-off revenue not captured by
// PlatformPayment, etc.) — deliberately separate from PlatformPayment (school activation/renewal
// revenue), not a replacement for it. FinanceService.overview() combines both sources for the
// platform's real "how much do we make" figure. Editable by SUPER_ADMIN and ASSISTANT_SUPER_ADMIN.
model PlatformFinanceEntry {
  id              String            @id @default(uuid())
  type            FinanceEntryType
  category        String
  amount          Int
  description     String?
  recordedByUserId String
  recordedBy      PlatformUser      @relation(fields: [recordedByUserId], references: [id])
  createdAt       DateTime          @default(now())
}

// One row per activation-fee headcount range (e.g. "1-100 people: KES 5,000"). Managed as a full
// list replace (delete-all + recreate) from the Pricing Tiers settings tab, not per-row CRUD — see
// PricingTiersService. maxHeadcount null means "no upper bound" (the top-open tier). The fee for a
// real (non-demo) school is always computed server-side from these via computeFee(), never trusted
// from the client — see TenantsService.requestCreate().
model PricingTier {
  id            String   @id @default(uuid())
  minHeadcount  Int
  maxHeadcount  Int?
  priceKes      Decimal
  // Storage cap (MB) auto-assigned to Tenant.storageLimitMbOverride when a real school lands in
  // this tier at creation — see TenantsService.confirmCreate(). Null means "no cap at this tier".
  storageLimitMb Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum EmailDirection {
  IN
  OUT
}

enum CampaignChannel {
  EMAIL
  SMS
  BOTH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum CampaignRecipientType {
  SCHOOL
  PLATFORM_ADMIN
  EXTERNAL
}

enum CampaignDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// A one-off broadcast (holiday greetings, maintenance notices, targeted follow-ups) — distinct from
// PlatformNotifierService's fixed, keyed system templates: campaign content is freeform and
// authored per-send, so it goes straight through EMAIL_PROVIDER/SMS_PROVIDER rather than the
// {{template}} substitution layer. Recipients are resolved and snapshotted into CampaignRecipient
// rows at creation time (not re-computed at send time), giving a stable send list and a durable
// per-recipient delivery record even if the underlying school/admin data changes later.
model Campaign {
  id              String          @id @default(uuid())
  subject         String
  emailBody       String?
  smsBody         String?
  channel         CampaignChannel @default(BOTH)
  status          CampaignStatus  @default(DRAFT)
  // Null means "send immediately" (dispatched synchronously right after creation). When set, a
  // per-minute cron (CampaignsService.dispatchScheduled()) picks it up once due.
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdByUserId String
  createdBy       PlatformUser    @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  recipients CampaignRecipient[]
}

// One row per resolved recipient at the moment the campaign was created — email/phone are copied in
// at that time (from Tenant.contactEmail/contactPhone or PlatformUser.email/phone), not looked up
// live at send time, so a later change to a school's contact details doesn't retroactively alter
// what an already-created campaign was addressed to. emailStatus/smsStatus are tracked
// independently since a channel a recipient lacks (no phone on file, etc.) is simply never
// attempted, not a failure.
model CampaignRecipient {
  id             String                 @id @default(uuid())
  campaignId     String
  campaign       Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type           CampaignRecipientType
  tenantId       String?
  tenant         Tenant?                @relation(fields: [tenantId], references: [id])
  platformUserId String?
  platformUser   PlatformUser?          @relation(fields: [platformUserId], references: [id])
  name           String
  email          String?
  phone          String?
  emailStatus    CampaignDeliveryStatus @default(PENDING)
  smsStatus      CampaignDeliveryStatus @default(PENDING)
  emailError     String?
  smsError       String?
  createdAt      DateTime               @default(now())

  @@index([campaignId])
}

// One row per named identity (info@/partner@/billing@/personal@hamzonetechnologies.com) — a fixed,
// small set enforced at the application layer via `key`, not a DB enum, so a fifth identity could be
// added later without a migration. Rows are lazily upserted-by-key on first access (same singleton-
// row precedent as PlatformSettings), not migration-seeded. `password` and the other credential
// fields are nullable — unset until a Super Admin configures real IMAP/SMTP creds via the OTP-gated
// Mailboxes settings tab; quietly does nothing until then, same graceful-degradation precedent as
// every other credential this platform stores (Mpesa/Resend/Advanta).
model PlatformMailbox {
  id           String   @id @default(uuid())
  key          String   @unique
  address      String
  displayName  String
  smtpHost     String?
  smtpPort     Int?
  smtpSecure   Boolean  @default(true)
  imapHost     String?
  imapPort     Int?
  imapSecure   Boolean  @default(true)
  username     String?
  password     String?
  lastPolledAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  threads      PlatformEmailThread[]
}

model PlatformEmailThread {
  id               String   @id @default(uuid())
  mailboxId        String
  mailbox          PlatformMailbox @relation(fields: [mailboxId], references: [id])
  subject          String
  participantEmail String
  participantName  String?
  lastMessageAt    DateTime
  createdAt        DateTime @default(now())

  messages         PlatformEmailMessage[]

  @@index([mailboxId, lastMessageAt])
}

model PlatformEmailMessage {
  id           String   @id @default(uuid())
  threadId     String
  thread       PlatformEmailThread @relation(fields: [threadId], references: [id])
  direction    EmailDirection
  fromAddress  String
  toAddress    String
  subject      String
  bodyText     String
  bodyHtml     String?
  // RFC822 Message-ID header — dedupes re-polled IMAP messages and, via inReplyTo, builds proper
  // reply threading so the recipient's own mail client shows this as one conversation.
  messageId    String?  @unique
  inReplyTo    String?
  // Only meaningful for direction: IN — an OUT message is implicitly "read" (the sender wrote it).
  read         Boolean  @default(false)
  sentByUserId String?
  sentBy       PlatformUser? @relation(fields: [sentByUserId], references: [id])
  createdAt    DateTime @default(now())

  @@index([threadId, createdAt])
}

// One row per online "session" — created the moment a user goes from offline to online (their
// first tab connecting), closed when their last tab disconnects. Backs the 24h presence history
// view (PresenceService.history()); pruned after 7 days by a daily cron (see PresenceGateway) so
// this doesn't grow forever. Denormalized fullName/role/schoolName the same way PresenceService's
// in-memory registry already does, so history reads don't need a join back through Tenant/PlatformUser
// for a user who may have since been removed or renamed.
model PresenceSession {
  id             String    @id @default(uuid())
  realm          String
  userId         String
  fullName       String
  role           String?
  roles          Json?
  tenantSlug     String?
  schoolName     String?
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?

  activities     PresenceActivity[]

  @@index([connectedAt])
}

// Page/module visits during one PresenceSession — deliberately page-level, not literal click/element
// tracking (see the plan's scope note): meaningful proof of what was used, without the noise and
// privacy exposure of full clickstream capture across every parent/student account too.
model PresenceActivity {
  id         String   @id @default(uuid())
  sessionId  String
  session    PresenceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  path       String
  occurredAt DateTime @default(now())

  @@index([sessionId, occurredAt])
}

enum HamzoneJobPositionStatus {
  OPEN
  // Applicant cap (maxApplicants) reached — the public apply link shows "at capacity" and rejects
  // new submissions, but the position isn't necessarily filled yet (interviews may still be ongoing).
  CLOSED
  // The intended headcount (requiredPositions) has actually been hired.
  FILLED
}

enum HamzoneJobApplicationStatus {
  SUBMITTED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  HIRED
  REJECTED
}

// A vacancy the Super Admin opens — deliberately tracks two different numbers, per explicit
// instruction: `requiredPositions` is how many people the company actually intends to hire;
// `maxApplicants` is an unrelated cap on how many people are even allowed to apply before the
// public link closes itself ("fully capacity"). A position can need 2 hires but cap applications at
// 50 to keep the pool manageable — the two numbers are never assumed equal.
model HamzoneJobPosition {
  id                String                   @id @default(uuid())
  title             String
  // What tier of system access a successful applicant gets — reuses PlatformRole rather than a
  // separate enum so hiring maps directly onto the same role ladder RequirePlatformRole enforces.
  roleType          PlatformRole
  roleTypeOther     String?
  description       String
  requiredPositions Int
  maxApplicants     Int
  status            HamzoneJobPositionStatus @default(OPEN)
  closesAt          DateTime?
  createdByUserId   String
  createdBy         PlatformUser             @relation(fields: [createdByUserId], references: [id])
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  applications      HamzoneJobApplication[]
}

// One public applicant — fullName/experience/links/certificates are exactly what an applicant
// supplies through the public apply API (see PublicRecruitmentController), never trusted from an
// authenticated caller. hiredUserId is set only once HamzoneRecruitmentService.hire() actually
// creates their PlatformUser login.
model HamzoneJobApplication {
  id                String                       @id @default(uuid())
  positionId        String
  position          HamzoneJobPosition           @relation(fields: [positionId], references: [id])
  fullName          String
  email             String
  phone             String
  address           String?
  experienceSummary String?
  linkedinUrl       String?
  githubUrl         String?
  certificateUrls   String[]
  coverNote         String?
  status            HamzoneJobApplicationStatus  @default(SUBMITTED)
  interviewAt       DateTime?
  interviewNotes    String?
  rejectedReason    String?
  hiredUserId       String?
  hiredUser         PlatformUser?                @relation("JobApplicationHiredUser", fields: [hiredUserId], references: [id])
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([positionId, status])
}

enum HamzoneStaffTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// A concrete assignment for hired staff ("software engineers... which repo, which task") — deliberately
// simple (no sprints/boards) since this is meant to give a new hire somewhere to start, not replace a
// real project-management tool.
model HamzoneStaffTask {
  id               String                 @id @default(uuid())
  assignedToUserId String
  assignedTo       PlatformUser           @relation("StaffTaskAssignedTo", fields: [assignedToUserId], references: [id])
  title            String
  description      String?
  repoUrl          String?
  dueDate          DateTime?
  status           HamzoneStaffTaskStatus @default(TODO)
  assignedByUserId String
  assignedBy       PlatformUser           @relation("StaffTaskAssignedBy", fields: [assignedByUserId], references: [id])
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([assignedToUserId, status])
}
