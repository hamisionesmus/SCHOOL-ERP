# Copy this to `.env` inside apps/api on the server (once, by hand — never committed, never
# touched by deploys). Fill in the real values from cPanel's PostgreSQL Databases page.

# cPanel prefixes both the DB name and DB user with your account username, e.g.
# cztgoxji_schoolerp / cztgoxji_erpapp. Password is whatever you set in the PostgreSQL Database Wizard.
DATABASE_URL=postgresql://CPANEL_DB_USER:CPANEL_DB_PASSWORD@localhost:5432/CPANEL_DB_NAME?schema=public

# Any long random strings — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# One-time Super Admin seed (only used the first time you run `npm run prisma:seed`)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Passenger sets PORT itself — do not set this manually in production.
# API_PORT=4000
