# Copy to `.env` at the repo root on the server (once, by hand — gitignored, never touched by
# deploys). Used by docker-compose.prod.yml for variable substitution.

POSTGRES_USER=erp
POSTGRES_PASSWORD=
POSTGRES_DB=school_erp

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# One-time Super Admin seed. SUPER_ADMIN_PHONE is optional — if set, school-creation confirmation
# codes are SMS'd here in addition to email.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PHONE=

# Baked into the web app's client bundle at build time.
NEXT_PUBLIC_API_URL=https://api.myschoolapp.xyz

# Used to build links in outbound emails/SMS (activation link, login link, invoice notices).
WEB_ORIGIN=https://myschoolapp.xyz

# M-Pesa STK Push (Safaricom Daraja) — school activation payments only. From the Daraja app's
# "Lipa Na M-Pesa Online" credentials. MPESA_ENV is "sandbox" or "production".
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.myschoolapp.xyz/public/activation/mpesa-callback

# Outbound platform email — self-hosted via the `postfix` service in docker-compose.prod.yml
# (SMTP_HOST/SMTP_PORT are already set there for you). Signs/sends as hamzonetechnologies.com, not
# myschoolapp.xyz — that domain's own DNS zone was found deprovisioned on the DNS host's end. Only
# the from-address is yours to set; see docs/DEPLOYMENT.md "Email" section for the DNS records
# (DKIM + PTR) this actually needs to be deliverable, not just sendable.
SMTP_FROM_ADDRESS=School ERP <noreply@hamzonetechnologies.com>

# Resend (https://resend.com) — alternative managed-ESP path, not currently wired in
# (platform-email.module.ts binds SmtpEmailProvider). Leave blank; kept here in case you switch
# back to a managed provider later.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=School ERP <no-reply@myschoolapp.xyz>

# Advanta SMS (https://developers.advantasms.com) — outbound platform SMS. Leave blank to fall
# back to logging instead of sending (see StubSmsProvider) — safe for local dev.
ADVANTA_API_KEY=
ADVANTA_PARTNER_ID=
ADVANTA_SENDER_ID=Falem Sacco
