# Copy to `.env` at the repo root on the server (once, by hand — gitignored, never touched by
# deploys). Used by docker-compose.prod.yml for variable substitution.

POSTGRES_USER=erp
POSTGRES_PASSWORD=
POSTGRES_DB=school_erp

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# One-time Super Admin seed
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Baked into the web app's client bundle at build time.
NEXT_PUBLIC_API_URL=https://api.myschoolapp.xyz
